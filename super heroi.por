programa {
  funcao inicio() {
    cadeia nome 
    inteiro nivelPoder 
    real velocidadeMaxima
    logico habilidadedeVoo

    nome = "Batman"
    nivelPoder = 600
    velocidadeMaxima = 299792.0
    habilidadedeVoo = verdadeiro

    escreva("========== FICHA DE SUPER-HERÓI =========\n")
    escreva("Nome: ", nome, "\n")
    escreva("Nível de poder: ", nivelPoder, "\n")
    escreva("Velocidade máxima: ", velocidadeMaxima, "km/h\n")
    escreva("Habilidade de voo: ", habilidadedeVoo)
     }
}
